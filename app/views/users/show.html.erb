<div class='container px-5 px-sm-0'>
  <div class='row'>
    <div class='col-md-3'>
      <h2>ユーザー詳細画面</h2>
      <%= render 'info', user: @user %>
      <h2 class="mt-3">投稿フォーム</h2>
      <%= render 'posts/form', post: @post %>
    </div>
    <div class='col-md-8 offset-md-1'>
      <h2>投稿一覧</h2>
      <%= render 'posts/index',posts: @posts %>
    </div>
  </div>
</div>