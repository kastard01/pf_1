
<table class='table table-hover table-inverse'>
  <thead>
    <tr>
      <th></th>
      <th>場所の名前</th>
      <th>説明文</th>
      <th colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <% posts.each do |post| %>
      <tr>
        <td><%= link_to(post.user) do %>
          <%= image_tag post.user.get_profile_image(50, 50), size:'50x50' %>
          <% end %>
        </td>
        <td><%= link_to post.landscape_name, post %></td>
        <td><%= post.caption %></td>
        <td class=<%= "favorite-" + post.id.to_s %> >
            <%#= render "favorites/btn", post: post %>
        </td>
        <td><%# render "post_comments/counter", post: post %></td>
      </tr>
    <% end %>
  </tbody>
</table>