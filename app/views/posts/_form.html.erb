<%= form_with model: post, local: true do |f| %>
  <h1>Post Form</h1>

  <div class="form-group">
    <%= f.label :image, "ファイル" %>
    <%= f.file_field :image %>
  </div>

  <div class="form-group">
    <%= f.label :landscape_name, "場所名" %>
    <%= f.text_field :landscape_name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :caption, "説明文" %>
    <%= f.text_area :caption, class: "form-control" %>
  </div>
  
  <%= f.submit class: 'btn btn-success' %>
<% end %>
