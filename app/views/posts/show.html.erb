<div class='container'>
  <div class='row'>
    <div class='col-md-3'>
      <h2>User info</h2>
      <%= render 'users/info', user: @post.user %>
      <h2 class="mt-3">New Post</h2>
      <%= link_to "新規投稿", new_post_path %>
      <%#= render 'form', post: Post.new %>
    </div>
    <div class='col-md-8 offset-md-1'>
  		<h2>caption</h2>
  		<table class='table'>
  		  <tr>
          <td><%= link_to(@post.user) do %>
            <%= image_tag @post.user.get_profile_image(100, 100), size:"100x100" %><br>
            <%= @post.user.name %>
            <% end %>
          </td>
          <td><%= link_to @post.landscape_name, @post %></td>
          <td><%= @post.caption %></td>
          <td class=<%= "favorite-" + @post.id.to_s %> >
            <%#= render "favorites/btn", post: @post %>
          </td>
          <td class="post-comments-counter">
            <%#= render "post_comments/counter", post: @post %>
          </td>
          <% if @post.user == current_user %>
            <td><%= link_to '編集', edit_post_path(@post), class: "btn btn-sm btn-success edit_post_#{@post.id}" %></td>
            <td><%= link_to '削除', @post, method: :delete, data: { confirm: '本当に消しますか？' }, class: "btn btn-sm btn-danger" %></td>
          <% end %>
        </tr>
      </table>
      
      <div class="post-comments-index">
        <%#= render "post_comments/index", post: @post %>
      </div>
      
      <%#= render "post_comments/form", post: @post, post_comment: @post_comment %>
      
    </div>
  </div>
</div>